{
  "name": "opencode-harness2",
  "version": "0.1.0-dev.1",
  "private": true,
  "description": "An experimental OpenCode 2 plugin and adapter for the upstream Harness² method.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/JF3Env/opencode-harness2.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./client": { "types": "./dist/client.d.ts", "import": "./dist/client.js" }
  },
  "bin": { "opencode-harness2": "./dist/cli.js" },
  "files": [
    "dist",
    "python/controller.py",
    "requirements-harness2.txt",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-reporter=tap tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run build && npm run typecheck && npm test && npm run test:python && npm run test:package",
    "test:python": ".venv/bin/python -B -m unittest discover -s python/tests -v",
    "test:package": "node scripts/test-package.mjs",
    "smoke:live": "npm run build && node scripts/live-load.mjs",
    "prepare": "npm run build",
    "doctor": "node --experimental-strip-types src/doctor.ts"
  },
  "dependencies": {
    "@opencode/client": "2.0.32",
    "@opencode/plugin": "2.0.32"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
